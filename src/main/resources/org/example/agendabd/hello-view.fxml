          <TableColumn fx:id="colPersonaId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colPersonaNombre" prefWidth="250.0" text="Nombre" />
            <TableColumn fx:id="colPersonaDireccion" prefWidth="250.0" text="Dirección" />
        </columns>
      </TableView>
      <TextField alignment="CENTER" prefHeight="25.0" prefWidth="575.0" text="Personas" />
